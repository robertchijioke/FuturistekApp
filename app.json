{
  "expo": {
    "name": "Futuristek",
    "slug": "futuristek-app",
    "scheme": "futuristek",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.anonymous.FuturistekApp",
      "adaptiveIcon": {
        "backgroundColor": "#020817",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#020817"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/images/sounds/order_alert.wav"
          ]
        }
      ],
      "expo-router",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63da351c-8929-46d8-8e0e-c5d1c32e711b"
      }
    },
    "owner": "robertchijioke"
  }
}
