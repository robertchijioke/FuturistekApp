rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/userAccessProfiles/$(request.auth.uid)
        );
    }

    function accessProfile() {
      return get(
        /databases/$(database)/documents/userAccessProfiles/$(request.auth.uid)
      ).data;
    }

    function hasEnabledAccessProfile() {
      return profileExists()
        && accessProfile().enabled == true;
    }

    function isEnterpriseAdmin() {
      return hasEnabledAccessProfile()
        && accessProfile().role == "ENTERPRISE_ADMIN";
    }

    function isSiteManager() {
      return hasEnabledAccessProfile()
        && accessProfile().role == "SITE_MANAGER";
    }

    function hasAssignedSite(siteId) {
      return hasEnabledAccessProfile()
        && siteId is string
        && siteId in accessProfile().siteIds;
    }

    function canReadSite(siteId) {
      return isEnterpriseAdmin()
        || (
          isSiteManager()
          && hasAssignedSite(siteId)
        );
    }

    match /userAccessProfiles/{uid} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isEnterpriseAdmin()
        );

      allow create, update, delete: if false;
    }

    match /careSites/{siteId} {
      allow read: if canReadSite(siteId);
      allow write: if isEnterpriseAdmin();
    }

    match /residents/{residentId} {
      allow read: if canReadSite(
        resource.data.get("siteId", "")
      );

      allow write: if isEnterpriseAdmin();
    }

    match /careEvents/{eventId} {
      allow read: if canReadSite(
        resource.data.get("siteId", "")
      );

      allow write: if isEnterpriseAdmin();
    }

    match /orders/{orderId} {
      allow read: if isEnterpriseAdmin()
        || (
          signedIn()
          && !profileExists()
          && resource.data.get("userId", "") ==
            request.auth.uid
        );

      allow create, update, delete:
        if isEnterpriseAdmin();
    }

    match /{topLevelCollection}/{document=**} {
      allow read, write: if
        topLevelCollection != "userAccessProfiles"
        && topLevelCollection != "careSites"
        && topLevelCollection != "residents"
        && topLevelCollection != "careEvents"
        && topLevelCollection != "orders"
        && isEnterpriseAdmin();
    }
  }
}